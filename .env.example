# Copy to .env and replace every CHANGE_ME value. Never commit .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# Separate credentials per service
POSTGRES_USER=gateway
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=gateway
DATABASE_URL=postgresql+asyncpg://gateway:CHANGE_ME@postgres:5432/gateway

REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379/0

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_ME_AT_LEAST_32_CHARS
JWT_ALGORITHM=HS256
JWT_ISSUER=sovereign-ai-gateway
JWT_AUDIENCE=sovereign-ai-gateway-api
ACCESS_TOKEN_TTL_SECONDS=900

CORS_ORIGINS=http://localhost:5173
MAX_REQUEST_BYTES=1048576
AUDIT_RETENTION_DAYS=365
RATE_LIMIT_PER_MINUTE=60

# Separate key for keyed entity hashes and pseudonyms (not the JWT secret).
ENTITY_HASH_KEY=CHANGE_ME_AT_LEAST_32_CHARS
# required | optional | disabled. Keep 'required' outside local development.
NER_MODE=required

# Optional local LLM reviewer for uncertain injection verdicts (OpenAI-compatible, self-hosted,
# e.g. http://ollama:11434/v1). Leave empty to disable. Never use a third-party API here.
LLM_REVIEWER_URL=
LLM_REVIEWER_MODEL=llama3.1:8b
LLM_REVIEWER_TIMEOUT_S=3

# Model backend approved requests are forwarded to (OpenAI-compatible, self-hosted). Compose
# points the gateway at its ollama service by default; set MODEL_BACKEND_URL= (empty) for
# decision-only mode.
# MODEL_BACKEND_URL=http://ollama:11434/v1
MODEL_CHAT=llama3.2:3b
MODEL_EMBED=nomic-embed-text
MODEL_TIMEOUT_S=120
MODEL_MAX_TOKENS=512

# ---- Streaming (Task 2) ----------------------------------------------------------------------
# Every decision also writes a governance event to the event_outbox table in the same
# transaction; the event-publisher service relays it to Kafka (governance.events.raw).
EVENT_OUTBOX_ENABLED=true
# KRaft cluster id (22-char base64url of 16 random bytes). Compose has a default; override to
# start a fresh cluster:  python -c "import base64,uuid;print(base64.urlsafe_b64encode(uuid.uuid4().bytes).decode().rstrip('='))"
# KAFKA_CLUSTER_ID=
# KAFKA_HEAP_OPTS=-Xms512m -Xmx512m

# event-publisher
PUBLISHER_BATCH_SIZE=500
PUBLISHER_BACKOFF_BASE_S=1
PUBLISHER_BACKOFF_MAX_S=300

# event-producer (continuous mode under `docker compose up`; backfill via `make verify-1m`)
PRODUCER_RATE=10
PRODUCER_SEED=42
PRODUCER_FAILURE_RATE=0
PRODUCER_DUPLICATE_RATE=0
PRODUCER_SPAN_HOURS=24
PRODUCER_DISORDER_S=30

# spark-stream-processor (phase S2). The migrate service creates a least-privilege
# stream_processor login with this password (16-128 chars of A-Z a-z 0-9 _ -).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
PROCESSOR_DB_PASSWORD=CHANGE_ME_16_PLUS_CHARS
SPARK_MASTER=local[4]
STREAM_TRIGGER=5 seconds
STREAM_WATERMARK=5 minutes
# 0 = unlimited (recommended): a per-batch offset cap is split across partitions by offset count,
# which lets low-volume partitions run ahead in event time and makes the watermark drop events.
STREAM_MAX_OFFSETS_PER_TRIGGER=0

# reporting-api (phase S3): password of the read-only reporting_ro database login.
REPORTING_DB_PASSWORD=CHANGE_ME_16_PLUS_CHARS
# Continuous producer tenants (comma-separated); default = the dashboard's demo tenant.
# PRODUCER_TENANT_IDS=aaaaaaaa-0000-4000-8000-000000000001
